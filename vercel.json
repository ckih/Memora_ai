{
  "framework": "nextjs",
  "rootDirectory": "apps/frontend",
  "buildCommand": "cd ../.. && pnpm install --frozen-lockfile && pnpm --filter frontend build",
  "outputDirectory": ".next",
  "rewrites": [
    { "source": "/api/v1/:path*", "destination": "https://REPLACE_WITH_YOUR_BACKEND_URL/api/v1/:path*" }
  ]
}
